@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqf: <https://ce-rise-models.codeberg.page/data-quality-framework/> .
@prefix lca: <https://ce-rise-models.codeberg.page/integrated-lca/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix mt: <https://ce-rise-models.codeberg.page/metrological-traceability/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uq: <https://ce-rise-models.codeberg.page/uncertainty-quantification/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dqf:DataQualityFramework a owl:Class ;
    rdfs:label "DataQualityFramework" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:data_quality_evidence_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:DataQualityProfile ;
            owl:onProperty dqf:data_quality_profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:remediation_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:quality_issues ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:quality_diagnostics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:quality_aggregations ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:DataCharacterization ;
            owl:onProperty dqf:data_characterizations ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:QualityDiagnostic ;
            owl:onProperty dqf:quality_diagnostics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:data_quality_profiles ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:DataQualityEvidenceReference ;
            owl:onProperty dqf:data_quality_evidence_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:QualityIssue ;
            owl:onProperty dqf:quality_issues ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:DataQualityAssessment ;
            owl:onProperty dqf:data_quality_assessments ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:QualityMetric ;
            owl:onProperty dqf:quality_metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:data_characterizations ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:UncertaintyTranslation ;
            owl:onProperty dqf:uncertainty_translations ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:QualityCriterionAssessment ;
            owl:onProperty dqf:criterion_assessments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:data_quality_assessments ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:QualityAggregation ;
            owl:onProperty dqf:quality_aggregations ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:RemediationAction ;
            owl:onProperty dqf:remediation_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:quality_metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:uncertainty_translations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:criterion_assessments ] ;
    skos:definition "Root container for data quality assessments and supporting records" ;
    skos:exactMatch dqf:dataQualityFramework ;
    skos:inScheme dqf: ;
    lca:sql_identifier "dqf_root" .

<https://ce-rise-models.codeberg.page/integrated-lca/.owl.ttl> a owl:Ontology ;
    rdfs:label "integrated-lca" ;
    dcterms:license "CC BY-NC 4.0" ;
    dcterms:title "CE-RISE Integrated Life Cycle Analysis Data Model" ;
    pav:version "0.2.0" ;
    skos:definition """Flexible framework for reproducible life cycle assessment across environmental, social, and economic dimensions, including study metadata, versioned assessment inputs, toolchains, methods, results, and data quality indicators. Supports both Digital Product Passports (DPP) and Digital Material Passports (DMP).
""" .

lca:IntegratedLCAResults a owl:Class ;
    rdfs:label "IntegratedLCAResults" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom lca:LCAAnalysisInstance ;
            owl:onProperty lca:lca_analysis_instances ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:lca_analysis_instances ] ;
    skos:definition "Root container for life cycle assessment instances across environmental, social, and economic dimensions" ;
    skos:inScheme lca: ;
    lca:references "ESPR; Battery Pass; CIRPASS; King et al.; Berger et al." .

lca:applicable_standards_value a owl:DatatypeProperty ;
    rdfs:label "applicable_standards_value" ;
    rdfs:range xsd:string ;
    skos:definition "List of LCA standards followed (ISO 14040, PEF, EPD, etc.)" ;
    skos:inScheme lca: ;
    lca:owl.filler "dcterms:conformsTo" ;
    lca:references "ISO 14040:2006; ISO 14044:2006; ISO 14025:2006; ISO 14067:2018; Product Environmental Footprint (PEF); ESPR; King et al.; Battery Pass; CIRPASS" ;
    lca:sql_identifier "lca_applicable_standards" .

lca:assessed_system_reference_value a owl:DatatypeProperty ;
    rdfs:label "assessed_system_reference_value" ;
    rdfs:range xsd:string ;
    skos:definition "URI or ID pointing to the assessed system model used" ;
    skos:inScheme lca: ;
    lca:owl.filler "prov:used" ;
    lca:references "Berger et al.; CIRPASS" ;
    lca:sql_identifier "lca_assessed_system_ref" .

lca:assessed_system_version_value a owl:DatatypeProperty ;
    rdfs:label "assessed_system_version_value" ;
    rdfs:range xsd:string ;
    skos:definition "Version of the assessed system used for calculation" ;
    skos:inScheme lca: ;
    lca:owl.filler "dcterms:hasVersion" ;
    lca:references "Berger et al." ;
    lca:sql_identifier "lca_assessed_system_version" .

lca:assumptions_value a owl:DatatypeProperty ;
    rdfs:label "assumptions_value" ;
    rdfs:range xsd:string ;
    skos:definition "Key assumptions made in the analysis" ;
    skos:inScheme lca: ;
    lca:owl.filler "lca:assumptions" ;
    lca:references "Berger et al." ;
    lca:sql_identifier "lca_assumptions" .

lca:background_database_value a owl:DatatypeProperty ;
