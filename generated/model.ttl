lca:QualityFlagEnum a owl:Class ;
    rdfs:label "QualityFlagEnum" ;
    owl:unionOf ( <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#green_proceed> <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#orange_review> <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#red_reject> <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#grey_not_evaluated> ) ;
    skos:definition "Operational decision flags derived from quality scores" ;
    skos:inScheme dqf: ;
    linkml:permissible_values <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#green_proceed>,
        <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#grey_not_evaluated>,
        <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#orange_review>,
        <https://ce-rise-models.codeberg.page/integrated-lca/QualityFlagEnum#red_reject> .

