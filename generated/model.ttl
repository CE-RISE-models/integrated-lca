lca:IndicatorResult a owl:Class ;
    rdfs:label "IndicatorResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dqf:DataQualityAssessment ;
            owl:onProperty lca:indicator_data_quality_assessments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty lca:numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty lca:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:indicator_data_quality_assessments ],
        [ a owl:Restriction ;
            owl:allValuesFrom mt:TraceabilityStatement ;
            owl:onProperty lca:indicator_metrological_traceability_statements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lca:numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom uq:UncertaintyStatement ;
            owl:onProperty lca:indicator_uncertainty_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:indicator_uncertainty_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:uncertainty_range ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty lca:indicator_metrological_traceability_statements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lca:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom lca:UncertaintyRange ;
            owl:onProperty lca:uncertainty_range ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty lca:uncertainty_range ] ;
    skos:definition "Numeric assessment result with unit and uncertainty information" ;
    skos:inScheme lca: ;
    lca:references "ISO 14040:2006; ISO 14044:2006; UNEP Guidelines for Social Life Cycle Assessment of Products and Organizations (2020); ISO 15686-5:2017" .

