        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty uq:covariance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty uq:covariance_value ],
        [ a owl:Restriction ;
